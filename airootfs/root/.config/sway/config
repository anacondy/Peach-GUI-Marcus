### Marcus Mix — Sway config
#
# This file is the compositor's single source of truth. Two things to know
# before editing:
#
#   * Environment variables (MOZ_ENABLE_WAYLAND, GDK_BACKEND, ...) are NOT set
#     here. Sway has no `setenv` command, and `export` inside an `exec` only
#     affects that one child shell. They live in ~/.zprofile, which runs
#     immediately before `exec sway` and is therefore inherited by every client.
#
#   * Every visual-effect directive (blur, shadows, corner_radius, layer_effects)
#     is SwayFX-only and has been moved to `include ~/.config/sway/effects.conf`,
#     which scripts/perf-profile.sh generates. See that script's header for why.

# --- Variables ---
set $mod Mod4
set $alt Mod1
set $term kitty
set $menu wofi --show drun --allow-images

# --- Autostart ---
# `exec` runs once per session. `exec_always` also re-runs on `swaymsg reload`,
# and it does NOT kill the previous instance first - so using exec_always for a
# long-lived daemon stacks a duplicate on top of the running one every reload.
# The dock previously used exec_always and grew a new bar per reload; it now goes
# through start-dock.sh, which is safe to re-run.
exec waybar
exec mako

exec swayidle -w \
    timeout 300 'swaylock -f -c 1d2021' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    before-sleep 'swaylock -f -c 1d2021'

# --- Output ---
output * bg #1d2021 solid_color

# --- Input ---
input "type:touchpad" {
    tap enabled
    natural_scroll enabled
    dwt enabled
}

input "type:keyboard" {
    xkb_layout us
}

# --- Appearance ---
gaps inner 6
gaps outer 2
# Was `default_border pixel 2` — 0 is the deliberate change: windows are
# defined by rounded corner + shadow alone now, not a drawn border line.
default_border pixel 0
default_floating_border pixel 0
font pango:JetBrains Mono 10

# ============================== EYE CANDY ====================================
# Generated by ~/.config/sway/scripts/perf-profile.sh (run from ~/.zprofile
# before sway starts, and again via exec_always below). Contains the rounded
# corners / blur / shadows / layer_effects block when SwayFX is present, and is
# comments-only on vanilla sway so it doesn't spam the log with
# "Unknown/invalid command" on every load. The `high` tier it writes is the same
# value-for-value effect set that used to be inline here, so the look is
# unchanged on hardware that can afford it.
include ~/.config/sway/effects.conf
# ============================== /EYE CANDY ===================================


# --- Core bindings ---
bindsym $mod+Return exec $term
bindsym $mod+d exec $menu
bindsym $mod+Shift+q kill
bindsym $mod+Shift+e exec swaynag -t warning -m 'Exit sway?' -B 'Yes' 'swaymsg exit'
bindsym $mod+Shift+c reload
bindsym $mod+f fullscreen
bindsym $mod+Shift+space floating toggle
bindsym $mod+Shift+x exec swaylock -f -c 1d2021

# --- Focus / move ---
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# --- Workspaces ---
bindsym $mod+1 workspace 1
bindsym $mod+2 workspace 2
bindsym $mod+3 workspace 3
bindsym $mod+4 workspace 4
bindsym $mod+5 workspace 5
bindsym $mod+Shift+1 move container to workspace 1
bindsym $mod+Shift+2 move container to workspace 2
bindsym $mod+Shift+3 move container to workspace 3
bindsym $mod+Shift+4 move container to workspace 4
bindsym $mod+Shift+5 move container to workspace 5

# --- Resize mode ---
mode "resize" {
    bindsym h resize shrink width 20px
    bindsym j resize grow height 20px
    bindsym k resize shrink height 20px
    bindsym l resize grow width 20px
    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

# --- Screenshots ---
# `mkdir -p` is not decorative. grim opens its output file with plain fopen(),
# so a missing ~/Pictures makes the whole capture fail silently - the keybinding
# did nothing at all on a fresh profile, where ~/Pictures does not exist.
bindsym Print exec mkdir -p ~/Pictures && grim ~/Pictures/Screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send 'Marcus Mix' 'Screenshot saved to ~/Pictures'
bindsym $mod+Print exec mkdir -p ~/Pictures && grim -g "$(slurp)" ~/Pictures/Screenshot-$(date +%Y%m%d-%H%M%S).png && notify-send 'Marcus Mix' 'Screenshot saved to ~/Pictures'

# --- Volume / brightness ---
bindsym XF86AudioRaiseVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%+
bindsym XF86AudioLowerVolume exec wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bindsym XF86AudioMute exec wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle
bindsym XF86MonBrightnessUp exec brightnessctl set +5%
bindsym XF86MonBrightnessDown exec brightnessctl set 5%-

# --- Authentication ---
exec /usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1

# --- Clipboard Persistence & History ---
exec wl-paste --type text --watch cliphist store
exec wl-paste --type image --watch cliphist store
bindsym $mod+v exec cliphist list | wofi --dmenu | cliphist decode | wl-copy

# --- Global Media Controls ---
bindsym XF86AudioPlay exec playerctl play-pause
bindsym XF86AudioNext exec playerctl next
bindsym XF86AudioPrev exec playerctl previous

# --- Popup / dialog handling ---
for_window [window_role="pop-up"] floating enable
for_window [window_role="task_dialog"] floating enable


# ============================== FRONTEND ADDITIONS ===========================

# Refresh-rate aware render latency + effect quality. Idempotent: it exits
# immediately when the outputs and the computed tier are unchanged, so repeated
# reloads don't reconfigure every panel.
exec_always ~/.config/sway/scripts/perf-profile.sh

# Smart per-output scaling — picks a sensible `output <name> scale` for
# whatever screen you're on. Also skips the swaymsg call when the scale it
# would set is already the current one.
exec_always ~/.config/sway/scripts/auto-scale.sh

# Spotlight-style search: apps + home directory files, instant.
bindsym $alt+space exec ~/.config/sway/scripts/spotlight.sh

# Dock — a second waybar instance (pinned launchers + running-app taskbar),
# alongside the main top bar started by `exec waybar` above. exec_always +
# start-dock.sh means a reload replaces the dock instead of stacking a second
# one on top of the first.
exec_always ~/.config/sway/scripts/start-dock.sh
